APP_NAME="Primepower ISMERS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en_PH
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

# JWT auth (php-open-source-saver/jwt-auth) — see ADR-0008
JWT_SECRET=
JWT_TTL=1440

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=primepower
DB_USERNAME=primepower
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend SPA origin (CORS) and mocked department integrations (ADR-0005, ADR-0007)
FRONTEND_URL=http://localhost:5173
# Public survey page origin (module 05). Falls back to FRONTEND_URL when unset — set it in
# production so emailed links point at the real host, never a hardcoded one.
# CRM_SURVEY_URL=https://crm.primepower.com
INTEGRATIONS_MODE=mock
