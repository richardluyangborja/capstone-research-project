APP_NAME="Primepower ISMERS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en_PH
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_PH

# JWT auth (php-open-source-saver/jwt-auth) — see ADR-0008
JWT_SECRET=
JWT_TTL=1440

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

# On a managed platform, use LOG_CHANNEL=stderr so logs reach the log collector.
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# Neon/production: set DB_URL to the Postgres connection string. When present it overrides the
# DB_HOST/DB_PORT/DB_DATABASE/DB_USERNAME/DB_PASSWORD values below.
# DB_URL=
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=primepower
DB_USERNAME=primepower
DB_PASSWORD=secret
# Neon requires TLS: use require. Use the direct (non-pooled) Neon URL for migrations.
DB_SSLMODE=prefer

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
# Contracts and attachments are private files. In production, mount a persistent disk at
# backend/storage or switch these disks to `s3` and provide the AWS_* values.
FILESYSTEM_DISK=local
CRM_CONTRACT_DISK=local
CRM_ATTACHMENT_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Frontend SPA origin (CORS) and mocked department integrations (ADR-0005, ADR-0007).
# Use the exact browser origin, including scheme and port, with no trailing slash.
FRONTEND_URL=http://localhost:5173
# Public survey page origin (module 05). Falls back to FRONTEND_URL when unset — set it in
# production so emailed links point at the real host, never a hardcoded one.
# CRM_SURVEY_URL=https://crm.primepower.com
INTEGRATIONS_MODE=mock

# Module 07 AI Management Reports (spec 15, S2, ADR-0022). The Groq key lives only in ai/.env;
# the shared AI_SERVICE_TOKEN must match the value there. Laravel sees the switch, URL, token and
# quota controls, never the Groq secret.
AI_REPORT_ENABLED=true
# Deployment: point this at the AI service's public URL.
AI_SERVICE_URL=http://127.0.0.1:8001
# Shared bearer token; must match AI_SERVICE_TOKEN in ai/.env. Required when generation is enabled.
AI_SERVICE_TOKEN=
AI_TIMEOUT_SECONDS=3
AI_CACHE_TTL_MINUTES=15
AI_REFRESH_COOLDOWN_MINUTES=5
AI_DAILY_LIMIT=800
AI_USER_DAILY_LIMIT=30
