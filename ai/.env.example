# Copy to ai/.env and fill in the free-tier Groq key. On a managed platform, set these as
# service environment variables instead of shipping a .env file.
# The Groq key is read by the Python service only; never put it in backend/.env or frontend code.
AI_PROVIDER=groq
AI_MODEL=openai/gpt-oss-20b
AI_TIMEOUT_SECONDS=2.5
# Shared bearer token; must match AI_SERVICE_TOKEN in backend/.env.
AI_SERVICE_TOKEN=
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
